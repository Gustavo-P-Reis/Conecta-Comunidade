# Copie este arquivo para ".env.local" e preencha com os dados do seu projeto Supabase.
# Painel do Supabase > Project Settings > API.
#
# NEXT_PUBLIC_SUPABASE_URL     -> "Project URL"
# NEXT_PUBLIC_SUPABASE_ANON_KEY -> "anon public" key (em painéis mais novos do Supabase
#                                   aparece como "publishable key" — é o mesmo valor).
#
# As duas variáveis começam com NEXT_PUBLIC_ porque precisam estar disponíveis no
# navegador. Isso é seguro: a "anon key" foi feita para ser pública, a segurança real
# vem das políticas de Row Level Security configuradas em supabase/policies.sql.
# NUNCA coloque a "service_role key" aqui nem em nenhum arquivo do frontend.

NEXT_PUBLIC_SUPABASE_URL= 
NEXT_PUBLIC_SUPABASE_ANON_KEY= 
